# Скопируйте в .env и при необходимости поменяйте. Без .env всё работает на значениях по умолчанию.

# ЕГРЮЛ: mock — демо-данные (по умолчанию), dadata — реальные данные по ИНН (бесплатно до 10 000 запросов в сутки)
EGRUL_PROVIDER=mock
DADATA_API_KEY=
# Открытые сервисы ФНС без ключа для ИНН вне демо-данных (нужен интернет)
EGRUL_PUBLIC_FNS=true

# Официальный API ЕИС (getDocsIP): загрузка извещения 44-ФЗ по реестровому номеру.
# Токен физлица выдаётся в личном кабинете zakupki.gov.ru (вход через Госуслуги). Пусто — загрузка только файлами.
EIS_TOKEN=

# LLM для разбора текстовых критериев: ollama (локально, по умолчанию), openai (любой OpenAI-совместимый API), none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Сколько ждать LLM при разборе критериев, сек (дальше — только правила)
LLM_PARSE_TIMEOUT_SECONDS=5
# Проверка оценки нейросетью: корректирует вердикт не больше чем на ступень, процент не меняет
LLM_REVIEW=true
LLM_REVIEW_TIMEOUT_SECONDS=3

# Заполнять пустую базу демо-закупками при первом запуске
SEED_DEMO_DATA=true
