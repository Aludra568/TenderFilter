# Скопируйте в .env и при необходимости поменяйте. Без .env всё работает на значениях по умолчанию.

# ЕГРЮЛ: mock — демо-данные (по умолчанию), dadata — реальные данные по ИНН (бесплатно до 10 000 запросов в сутки)
EGRUL_PROVIDER=mock
DADATA_API_KEY=

# LLM для разбора текстовых критериев: ollama (локально, по умолчанию), openai (любой OpenAI-совместимый API), none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Заполнять пустую базу демо-закупками при первом запуске
SEED_DEMO_DATA=true
